<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_xl">

        <!-- App logo placeholder -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:background="@color/saddlebrown" />

        <!--Heading-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_welcome"
            style="@style/TextHeading"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!--Subtitle-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            style="@style/TextBody"
            android:layout_marginBottom="@dimen/spacing_xl" />

        <!--Email input-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_email_hint"
            app:boxStrokeColor="@color/saddlebrown"
            app:hintTextColor="@color/saddlebrown"
            android:layout_marginBottom="@dimen/spacing_md">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/charcoal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--Password input-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/login_password_hint"
            app:boxStrokeColor="@color/saddlebrown"
            app:hintTextColor="@color/saddlebrown"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/saddlebrown"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/charcoal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--Forgot password link-->
        <TextView
            android:id="@+id/forgotPasswordLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/login_forgot_password"
            android:textColor="@color/copper"
            android:textSize="@dimen/text_body"
            android:padding="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!--Login button-->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_button"
            style="@style/ButtonPrimary"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!--Register link row-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                style="@style/TextBody" />

            <TextView
                android:id="@+id/registerLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_register_link"
                android:textColor="@color/saddlebrown"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:padding="@dimen/spacing_sm" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>